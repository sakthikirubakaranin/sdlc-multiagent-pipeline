# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6          # Model to use for all agents
ANTHROPIC_MAX_TOKENS=8192

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME=SDLC Agent Pipeline
APP_ENV=development                         # development | staging | production
APP_LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_random_secret

# ─── API Server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:////tmp/sdlc_pipeline.db  # Dev: SQLite (absolute path avoids disk I/O errors)
# DATABASE_URL=postgresql://user:pass@localhost:5432/sdlc_pipeline  # Prod: Postgres

# ─── Cloud Deployment (optional — only needed for Agent 9) ───────────────────
CLOUD_PROVIDER=aws                          # aws | gcp | azure

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# GCP
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=

# Azure
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ─── Output Storage ───────────────────────────────────────────────────────────
OUTPUTS_DIR=./outputs                       # Where agents write their artifacts

# ─── Whisper (Audio/Video Transcription) ─────────────────────────────────────
WHISPER_MODEL=base                          # tiny | base | small | medium | large
